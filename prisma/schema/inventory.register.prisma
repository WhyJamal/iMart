model InventoryRegister {
  id             String   @id @default(cuid())

  organizationId String
  productId      String

  // Qaysi sklad yacheykasiga tegishli — hozircha optional, chunki
  // eski yozuvlarda bu bo'lmaydi. Purchases/POS integratsiyasi
  // ulanganda yangi yozuvlar doim shu bilan yoziladi.
  warehouseCellId String?

  docType        String   // PURCHASE | SALE | ADJUSTMENT
  docId          String

  direction      String   // IN | OUT

  qty            Decimal  // for PostgreSQL @db.Decimal(14, 3)
  unitCost       Decimal? // for PostgreSQL @db.Decimal(14, 2)

  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
  warehouseCell  WarehouseCell? @relation(fields: [warehouseCellId], references: [id])

  @@index([organizationId, productId])
  @@index([warehouseCellId])
}