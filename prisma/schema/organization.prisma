model Organization {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bu tashkilot narsil (SaaS) orqali sotib olingan bo'lsa — o'sha
  // xariddagi Project.id shu yerda saqlanadi (qayta provisioning
  // qilib yubormaslik uchun tekshiriladi).
  saasProjectId          String?   @unique
  subscriptionExpiresAt  DateTime?

  // ── Tashkilot sozlamalari ──────────────────────────────────────────────
  // pricingMode — POS/savdoga mahsulot qo'shilganda TAKLIF qilinadigan
  // narx manbai: "CATALOG" -> Product.price (nomenklaturadagi narx),
  // "AVERAGE" -> ItemPrice (sklad yacheykasidagi joriy o'rtacha tannarx).
  // MUHIM: bu faqat SaleItem.unitPrice (mijozga sotish narxi)ga ta'sir
  // qiladi. O'rtacha tannarxning o'zi (ItemPrice/StockBalance) faqat
  // stock-actions.ts#applyStockMovement orqali, xarid/kirim harakatlari
  // asosida hisoblanadi va bu sozlamadan mutlaqo mustaqil — shuning
  // uchun rejimni oldinga-orqaga almashtiraverish bazani buzmaydi va
  // o'rtacha narxni qayta hisoblab yubormaydi.
  pricingMode            String    @default("CATALOG")

  // taxPercent — POS savdosiga qo'shiladigan soliq foizi (ilgari kodda
  // qattiq yozilgan 0.08 / 8% o'rniga endi tashkilot o'zi sozlaydi).
  taxPercent             Float     @default(8)

  members   OrganizationMember[]
  products  Product[]
  productCategories ProductCategory[]

  points     Point[]
  warehouses Warehouse[]
  contragents Contragent[]
  workScheduleTemplates WorkScheduleTemplate[]
  workSchedules         WorkSchedule[]

  inventoryRegisters InventoryRegister[]
  purchases          Purchase[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  purchaseReturns    PurchaseReturn[]
  writeOffs WriteOff[]
  transfers Transfer[]

  salaryRegisters    SalaryRegister[]
  payrollPayments    PayrollPayment[]
  workCalendars      WorkCalendar[]
  timesheets         Timesheet[]
  payrollAccruals    PayrollAccrual[]

  cashRegister       CashRegister?
  bankAccount        BankAccount?
  cashFlows          CashFlow[]
  promotions Promotion[]

  debtors            Debtor[]
  debtorPayments     DebtorPayment[]
  supplierPayments   SupplierPayment[]

  notifications      Notification[]
  receiptTemplates   ReceiptTemplate[]

}