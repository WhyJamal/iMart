model Organization {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bu tashkilot narsil (SaaS) orqali sotib olingan bo'lsa — o'sha
  // xariddagi Project.id shu yerda saqlanadi (qayta provisioning
  // qilib yubormaslik uchun tekshiriladi).
  saasProjectId          String?   @unique
  subscriptionExpiresAt  DateTime?

  members   OrganizationMember[]
  products  Product[]
  productCategories ProductCategory[]

  points     Point[]
  warehouses Warehouse[]
  contragents Contragent[]
  workScheduleTemplates WorkScheduleTemplate[]
  workSchedules         WorkSchedule[]

  inventoryRegisters InventoryRegister[]
  purchases          Purchase[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  purchaseReturns    PurchaseReturn[]
  writeOffs WriteOff[]
  transfers Transfer[]

  salaryRegisters    SalaryRegister[]
  payrollPayments    PayrollPayment[]
  workCalendars      WorkCalendar[]
  timesheets         Timesheet[]
  payrollAccruals    PayrollAccrual[]

  cashRegister       CashRegister?
  bankAccount        BankAccount?
  cashFlows          CashFlow[]
  promotions Promotion[]

  debtors            Debtor[]
  debtorPayments     DebtorPayment[]
  supplierPayments   SupplierPayment[]

}