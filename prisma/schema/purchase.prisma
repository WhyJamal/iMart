model Purchase {
  id             String   @id @default(cuid())
  receiptNumber  String   @unique

  organizationId String
  pointId        String?  // qaysi nuqtaga kirim qilingani
  contragentId   String?  // sotuvchi (Contragent, type=SUPPLIER)
  note           String?
  paymentMethod  String   @default("cash") // cash | card | qr
  paidAmount     Decimal @db.Decimal(14, 2) @default(0) // xarid vaqtida haqiqatda to'langan summa; for PostgreSQL @db.Decimal(14, 2)
  // umumiy summa = items yig'indisi (unitCost*qty); qarz = umumiy - paidAmount

  postedAt       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  point          Point?       @relation(fields: [pointId], references: [id])
  contragent     Contragent?  @relation(fields: [contragentId], references: [id])
  items          PurchaseItem[]
  returns        PurchaseReturn[]
}

model PurchaseItem {
  id              String   @id @default(cuid())
  receiptId       String
  productId       String
  warehouseCellId String?  // tovar qaysi sklad yacheykasiga kirim qilingani

  qty        Decimal @db.Decimal(14, 3) // for PostgreSQL @db.Decimal(14, 3)
  unitCost   Decimal @db.Decimal(14, 2) // for PostgreSQL @db.Decimal(14, 2)

  receipt    Purchase @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  warehouseCell WarehouseCell? @relation(fields: [warehouseCellId], references: [id])
  returnItems PurchaseReturnItem[]
}