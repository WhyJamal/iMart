model Purchase {
  id             String   @id @default(cuid())
  receiptNumber  String   @unique

  organizationId String
  supplierName   String?
  note           String?
  paymentMethod  String   @default("cash") // cash | card | qr

  postedAt       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PurchaseItem[]
  returns        PurchaseReturn[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  receiptId  String
  productId  String

  qty        Decimal  // for PostgreSQL @db.Decimal(14, 3)
  unitCost   Decimal  // for PostgreSQL @db.Decimal(14, 2)

  receipt    Purchase @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  returnItems PurchaseReturnItem[]
}