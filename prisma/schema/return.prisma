model SaleReturn {
  id             String   @id @default(cuid())
  returnNumber   String   @unique

  organizationId String
  saleId         String

  reason         String?
  paymentMethod  String   @default("cash") // cash | card | qr — pul qaysi usulda qaytariladi

  totalAmount    Decimal  // for PostgreSQL @db.Decimal(10, 2)

  createdBy      String?  // qaytarishni amalga oshirgan foydalanuvchi id

  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items          SaleReturnItem[]

  @@index([organizationId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  saleItemId String
  productId  String

  qty        Decimal  // qaytarilayotgan miqdor, for PostgreSQL @db.Decimal(14, 3)
  unitPrice  Decimal  // qaytarish vaqtidagi narx (asl SaleItem'dan olinadi), for PostgreSQL @db.Decimal(10, 2)

  return     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([saleItemId])
}
