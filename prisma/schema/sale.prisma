model Sale {
  id             String   @id @default(cuid())
  saleNumber     String   @unique

  organizationId String
  cashierId      String?
  pointId        String?  // qaysi nuqtadan sotilgani

  totalAmount    Decimal  // for PostgreSQL @db.Decimal(10, 2)
  paymentMethod  String   @default("cash") // cash | card | qr

  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  point          Point?       @relation(fields: [pointId], references: [id])
  items          SaleItem[]
  returns        SaleReturn[]
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String
  warehouseCellId String? // sotuvda qaysi yacheykadan yechilgani

  qty        Decimal  // for PostgreSQL @db.Decimal(14, 3)
  unitPrice  Decimal  // for PostgreSQL @db.Decimal(10, 2)

  sale       Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  warehouseCell WarehouseCell? @relation(fields: [warehouseCellId], references: [id])
  returnItems SaleReturnItem[]
}