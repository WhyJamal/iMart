// User — endi faqat IDENTITY: email/parol/ism. Qaysi tashkilotga
// tegishli, qaysi rolda, qaysi nuqtada ishlashi — bularning barchasi
// OrganizationMember'da (bitta user bir nechta tashkilotga a'zo
// bo'lishi mumkin, har birida boshqa rol/nuqta bilan).
model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  locale         String        @default("ru") // Locale type: ru | en | uz
  isActive       Boolean       @default(true)

  // Bu login narsil (SaaS) orqali avtomatik yaratilgan bo'lsa — o'sha
  // tomondagi haqiqiy foydalanuvchi ID'si shu yerda saqlanadi. Hozircha
  // faqat kuzatuv/kelajakdagi birlashtirish uchun, login jarayoniga
  // ta'sir qilmaydi.
  saasUserId     String?

  // Email tasdiqlash (ro'yxatdan o'tishda). Mavjud userlar migratsiyada
  // true bo'lib qoladi — faqat yangi ro'yxatdan o'tganlar false bilan
  // boshlaydi va /verify-email orqali kod kiritib tasdiqlaydi.
  emailVerified           Boolean   @default(true)
  verificationCode        String?
  verificationCodeExpiry  DateTime?

  // Parolni tiklash ("parolni unutdingizmi?" oqimi).
  resetCode        String?
  resetCodeExpiry  DateTime?

  memberships    OrganizationMember[]

  timesheetEntries    TimesheetEntry[]
  payrollAccrualLines PayrollAccrualLine[]

  salaryRegisters SalaryRegister[]
  payrollPayments PayrollPayment[]

  notifications   Notification[]
  cashierSales    Sale[]
  themeSettings   UserThemeSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// UserThemeSettings — har bir foydalanuvchining shaxsiy interfeys
// sozlamasi (rang, radius, shrift, mode). RootLayout (Server
// Component) shu jadvaldan o'qib, sahifani BIRINCHI marta chizishning
// o'zida to'g'ri ko'rinishda beradi — shuning uchun "avval standart,
// keyin foydalanuvchiniki" flash muammosi bo'lmaydi.
model UserThemeSettings {
  id        String   @id @default(cuid())
  userId    String   @unique

  mode      String   @default("system")
  primary   String   @default("red")
  radius    String   @default("medium")
  font      String   @default("geist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
