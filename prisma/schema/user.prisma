// User — endi faqat IDENTITY: email/parol/ism. Qaysi tashkilotga
// tegishli, qaysi rolda, qaysi nuqtada ishlashi — bularning barchasi
// OrganizationMember'da (bitta user bir nechta tashkilotga a'zo
// bo'lishi mumkin, har birida boshqa rol/nuqta bilan).
model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  password       String
  locale         String        @default("ru") // Locale type: ru | en | uz
  isActive       Boolean       @default(true)

  // Bu login narsil (SaaS) orqali avtomatik yaratilgan bo'lsa — o'sha
  // tomondagi haqiqiy foydalanuvchi ID'si shu yerda saqlanadi. Hozircha
  // faqat kuzatuv/kelajakdagi birlashtirish uchun, login jarayoniga
  // ta'sir qilmaydi.
  saasUserId     String?

  memberships    OrganizationMember[]

  timesheetEntries    TimesheetEntry[]
  payrollAccrualLines PayrollAccrualLine[]

  salaryRegisters SalaryRegister[]
  payrollPayments PayrollPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
